<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     FROSTY LAUNCHER — LAUNCHER HOME "STAGE" v2 (All Java Bindings Restored)
     ═══════════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14">

    <!-- Background artwork -->
    <ImageView
        android:id="@+id/lh_bg_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:contentDescription="@null"
        tools:src="@drawable/bg_hero_minecraft" />
    <ImageView
        android:id="@+id/lh_bg_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lh_scrim" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lh_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/lh_center_guide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.47" />

        <!-- ═══ BRAND CLUSTER (top-left) ═══ -->
        <LinearLayout
            android:id="@+id/lh_brand_cluster"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_lh_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/lh_brand_mark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_lh_brand_mark">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/cs_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lh_brand_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="FROSTY LAUNCHER"
                    android:textColor="#00D2FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="Deprecated" />

                <LinearLayout
                    android:id="@+id/lh_brand_origin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lh_brand_flag"
                        android:layout_width="15dp"
                        android:layout_height="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flag_india" />

                    <TextView
                        android:id="@+id/lh_brand_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.14"
                        android:maxLines="1"
                        android:text="FROST STUDIO"
                        android:textColor="#00D2FF"
                        android:textSize="7.5sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:background="#2EFFFFFF" />

            <LinearLayout
                android:id="@+id/lh_btn_youtube"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_lh_pill_youtube"
                android:clickable="true"
                android:contentDescription="YouTube"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="11dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_youtube" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:text="YouTube"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lh_btn_discord"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_lh_pill_discord"
                android:clickable="true"
                android:contentDescription="Discord"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="11dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_discord" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:text="Discord"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ ACCOUNT CHIP (top-right) ═══ -->
        <LinearLayout
            android:id="@+id/lh_account_chip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_lh_glass"
            android:paddingHorizontal="11dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/lh_account_head"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_lh_card_icon"
                android:padding="2dp"
                android:src="@drawable/ic_profile_player"
                app:tint="#00D2FF"
                android:contentDescription="Account" />

            <TextView
                android:id="@+id/lh_account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxWidth="110dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="GodVansh"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/lh_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="LOCAL"
                android:textColor="#00D2FF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_hd_badge_purple"
                android:includeFontPadding="false" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#00D2FF"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Player Name Tag -->
        <TextView
            android:id="@+id/lh_hero_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:maxWidth="230dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text=""
            android:fontFamily="@font/minecraftia"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_lh_nametag"
            android:includeFontPadding="false"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lh_account_chip" />

        <!-- 3D Player View -->
        <android.opengl.GLSurfaceView
            android:id="@+id/lh_player"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lh_hero_name"
            app:layout_constraintBottom_toTopOf="@id/lh_launch_row" />

        <!-- ═══ LAUNCH CLUSTER & ALL REQUIRED JAVA BINDINGS ═══ -->
        <LinearLayout
            android:id="@+id/lh_launch_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/lh_library">

            <View
                android:id="@+id/lh_btn_launch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/lh_launch_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lh_launch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/lh_edit_btn"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lh_launch_specs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:id="@+id/lh_spec_java_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lh_spec_ram_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Download Progress Card -->
        <LinearLayout
            android:id="@+id/lh_dl_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_lh_dl_pill"
            android:elevation="14dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="14dp"
            android:minWidth="248dp"
            app:layout_constraintWidth_max="330dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/lh_library">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/lh_dl_icon_wrap"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_lh_dl_icon">

                    <ImageView
                        android:id="@+id/lh_dl_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download"
                        app:tint="#00D2FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/minecraftia"
                        android:text="LAUNCHING"
                        android:textColor="#00D2FF"
                        android:textSize="8sp"
                        android:letterSpacing="0.12"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/lh_dl_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Preparing…"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lh_dl_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:fontFamily="@font/minecraftia"
                    android:text="0%"
                    android:textColor="#00D2FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/lh_dl_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_lh_dl_track" />

            <TextView
                android:id="@+id/lh_dl_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#B9B5C9"
                android:textSize="10.5sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Instance Library Carousel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lh_library"
            android:layout_width="0dp"
            android:layout_height="@dimen/lh_carousel_height"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/lh_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Your library will live here — create your first instance to begin."
            android:textColor="#B9B5C9"
            android:textSize="12sp
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@id/lh_library"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="44dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
